{
    "name": "esonhaya/haya-doctor",
    "description": "Reusable, read-only project diagnostics.",
    "type": "library",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Tools\\Doctor\\": "tools/Doctor/"
        }
    },
    "scripts": {
        "test:core": "php tools/Doctor/Tests/DiagnosticCoreTest.php",
        "test:registry": "php tools/Doctor/Tests/CheckRegistryTest.php",
        "test:contracts": "php tools/Doctor/Tests/StaticContractScannerTest.php",
        "doctor": "php bin/doctor-self.php"
    }
}
